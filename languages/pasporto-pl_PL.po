#. Plugin Name of the plugin
#: pasporto.php
#: src/Admin/SettingsPage.php:70
msgid "Pasporto - Digital Product Passport (DPP)"
msgstr "Pasporto - Digital Product Passport (DPP)"

#. Plugin URI of the plugin
#: pasporto.php
msgid "https://plogins.com/pasporto/"
msgstr "https://plogins.com/pasporto/"

#. Description of the plugin
#: pasporto.php
msgid "Show a Digital Product Passport (DPP) link, product identifier and sustainability data on WooCommerce product pages."
msgstr "Wyświetla link do cyfrowego paszportu produktu (DPP), identyfikator produktu i dane środowiskowe na stronach produktów WooCommerce."

#. Author of the plugin
#: pasporto.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: pasporto.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: pasporto.php:48
msgid "Pasporto - Digital Product Passport (DPP) for WooCommerce requires WooCommerce to be active."
msgstr "Pasporto - Digital Product Passport (DPP) for WooCommerce wymaga aktywnej wtyczki WooCommerce."

#: src/Admin/ProductMetaBox.php:38
#: src/Service/PassportService.php:112
#: src/Service/PassportService.php:127
msgid "Digital Product Passport (DPP)"
msgstr "Cyfrowy paszport produktu (DPP)"

#: src/Admin/ProductMetaBox.php:44
msgid "Unique Product ID (UPI / GTIN)"
msgstr "Unikalny identyfikator produktu (UPI / GTIN)"

#: src/Admin/ProductMetaBox.php:45
msgid "GS1 Digital Link, GTIN, EPC, or unique product passport identifier."
msgstr "GS1 Digital Link, GTIN, EPC lub unikalny identyfikator paszportu produktu."

#: src/Admin/ProductMetaBox.php:53
msgid "Passport URL"
msgstr "Adres URL paszportu"

#: src/Admin/ProductMetaBox.php:54
msgid "Web address of this product's digital product passport, as supplied by the manufacturer or importer."
msgstr "Adres internetowy cyfrowego paszportu tego produktu, przekazany przez producenta lub importera."

#: src/Admin/ProductMetaBox.php:62
msgid "Primary Material"
msgstr "Główny materiał"

#: src/Admin/ProductMetaBox.php:63
msgid "Main material composition (e.g. Organic Cotton, Recycled Aluminum, LiFePO4)."
msgstr "Główny skład materiałowy (np. bawełna organiczna, aluminium z recyklingu, LiFePO4)."

#: src/Admin/ProductMetaBox.php:71
msgid "Recycled Content (%)"
msgstr "Zawartość materiałów z recyklingu (%)"

#: src/Admin/ProductMetaBox.php:72
msgid "Share of recycled content in the product, as declared by the manufacturer (0 - 100%)."
msgstr "Udział materiałów z recyklingu w produkcie według deklaracji producenta (0 - 100%)."

#: src/Admin/ProductMetaBox.php:82
msgid "Carbon Footprint (kg CO2e)"
msgstr "Ślad węglowy (kg CO2e)"

#: src/Admin/ProductMetaBox.php:83
msgid "Life-cycle Global Warming Potential (GWP) per unit."
msgstr "Potencjał tworzenia efektu cieplarnianego (GWP) w cyklu życia, na sztukę."

#: src/Admin/ProductMetaBox.php:93
msgid "Circularity class (manufacturer-declared)"
msgstr "Klasa cyrkularności (deklaracja producenta)"

#: src/Admin/ProductMetaBox.php:94
msgid "Fill in only if the manufacturer states a class from A to E. Pasporto does not calculate it."
msgstr "Wypełnij tylko wtedy, gdy producent podaje klasę od A do E. Pasporto jej nie oblicza."

#: src/Admin/ProductMetaBox.php:97
msgid "Not specified"
msgstr "Nie określono"

#: src/Admin/ProductMetaBox.php:110
msgid "Declaration of Conformity (URL)"
msgstr "Deklaracja zgodności (URL)"

#: src/Admin/ProductMetaBox.php:111
msgid "Link to the EU declaration of conformity for this product."
msgstr "Link do deklaracji zgodności UE dla tego produktu."

#: src/Admin/SettingsPage.php:29
msgid "Pasporto DPP"
msgstr "Pasporto DPP"

#: src/Admin/SettingsPage.php:30
msgid "Product Passport (DPP)"
msgstr "Paszport produktu (DPP)"

#: src/Admin/SettingsPage.php:72
msgid "Choose where the passport data you enter on each product is shown. The same data is added to WooCommerce's structured data for the product."
msgstr "Wybierz, gdzie mają być wyświetlane dane paszportu wpisane przy każdym produkcie. Te same dane trafiają do danych strukturalnych produktu w WooCommerce."

#: src/Admin/SettingsPage.php:79
msgid "Enable Product Passports"
msgstr "Włącz paszporty produktów"

#: src/Admin/SettingsPage.php:83
msgid "Show the Digital Product Passport on product pages and add it to WooCommerce's structured data for the product"
msgstr "Wyświetlaj cyfrowy paszport produktu na stronach produktów i dodawaj go do danych strukturalnych produktu w WooCommerce"

#: src/Admin/SettingsPage.php:88
msgid "Display Location"
msgstr "Miejsce wyświetlania"

#: src/Admin/SettingsPage.php:92
msgid "In its own product tab (\"Digital Product Passport (DPP)\")"
msgstr "W osobnej zakładce produktu (\"Cyfrowy paszport produktu (DPP)\")"

#: src/Admin/SettingsPage.php:96
msgid "Under single product summary (near add to cart)"
msgstr "Pod podsumowaniem produktu (przy przycisku dodawania do koszyka)"

#: src/Service/PassportService.php:134
msgid "Product Identifier (UPI / GTIN):"
msgstr "Identyfikator produktu (UPI / GTIN):"

#: src/Service/PassportService.php:141
msgid "Primary Material:"
msgstr "Główny materiał:"

#: src/Service/PassportService.php:148
msgid "Recycled Content:"
msgstr "Zawartość materiałów z recyklingu:"

#: src/Service/PassportService.php:155
msgid "Carbon Footprint (GWP):"
msgstr "Ślad węglowy (GWP):"

#: src/Service/PassportService.php:162
msgid "Circularity class (manufacturer-declared):"
msgstr "Klasa cyrkularności (deklaracja producenta):"

#: src/Service/PassportService.php:169
msgid "Declaration of Conformity:"
msgstr "Deklaracja zgodności:"

#: src/Service/PassportService.php:172
msgid "View document"
msgstr "Zobacz dokument"

#: src/Service/PassportService.php:181
msgid "Open the product passport"
msgstr "Otwórz paszport produktu"
